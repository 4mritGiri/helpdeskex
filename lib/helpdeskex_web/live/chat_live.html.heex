<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_view="chat"
  sidebar_collapsed={@sidebar_collapsed}
  stats={@stats}
  current_scope={@current_scope}
  theme={@theme}
>
  <meta id="chat-token" content={@chat_token} />
  <meta id="current-user-id" content={@current_user.id} />

  <div class="flex h-full w-full bg-white dark:bg-[#0E0E10] overflow-hidden relative font-sans">
    
<!-- ── SIDEBAR ────────────────────────────────────────────────────────── -->
    <aside class="w-[320px] sm:w-[320px] lg:w-[350px] flex-shrink-0 flex flex-col border-r border-slate-200 dark:border-[#1E1E20] bg-slate-50 dark:bg-[#161618] z-20">
      
<!-- Sidebar Header -->
      <div class="h-[64px] px-5 flex items-center justify-between shrink-0">
        <h2 class="text-[17px] font-bold text-slate-900 dark:text-white tracking-tight">
          Messages
        </h2>
        <div class="flex items-center gap-2 text-slate-400 dark:text-zinc-500">
          <button
            phx-click="open_group_modal"
            class="p-1.5 rounded-lg hover:text-slate-700 hover:bg-slate-200 dark:hover:text-zinc-300 dark:hover:bg-white/5 transition-colors"
            title="New Group"
          >
            <.icon name="hero-user-group" class="w-5 h-5" />
          </button>
          <button
            phx-click="open_new_chat"
            class="p-1.5 rounded-lg hover:text-slate-700 hover:bg-slate-200 dark:hover:text-zinc-300 dark:hover:bg-white/5 transition-colors"
            title="New Direct Message"
          >
            <.icon name="hero-pencil-square" class="w-5 h-5" />
          </button>
        </div>
      </div>
      
<!-- Search -->
      <div class="px-5 pb-3 shrink-0">
        <div class="relative group">
          <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-slate-400 dark:text-zinc-500">
            <.icon name="hero-magnifying-glass" class="w-4 h-4" />
          </div>
          <input
            id="sidebar-search-input"
            type="text"
            placeholder="Search conversations..."
            class="w-full bg-white dark:bg-[#1E1E20] border border-slate-200 dark:border-white/5 rounded-full py-2 pl-10 pr-4 text-[13px] text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-indigo-500/50 dark:focus:border-[#38383B] transition-all shadow-none"
          />
        </div>
      </div>
      
<!-- Conversation List -->
      <div id="conversations-container" class="flex-1 overflow-y-auto px-3 py-1 space-y-0.5">
        <button
          phx-click="open_personal_space"
          class="w-full flex items-center gap-3 p-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-white/5 transition-colors group mb-4 border border-dashed border-slate-200 dark:border-white/10 outline-none"
        >
          <div class="size-10 rounded-full bg-slate-100 dark:bg-white/5 flex items-center justify-center text-[#8B5CF6]">
            <.icon name="hero-user" class="w-5 h-5" />
          </div>
          <div class="flex-1 text-left">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-[#8B5CF6] transition-colors">
              Personal Space
            </h3>
            <p class="text-[10px] text-slate-500 dark:text-zinc-500 uppercase tracking-wider font-bold">
              Notes & Tasks
            </p>
          </div>
        </button>

        <%= if @conversations == [] do %>
          <div class="flex flex-col items-center justify-center pt-10 text-center px-4">
            <p class="text-xs text-slate-500 dark:text-zinc-500">No messages yet.</p>
          </div>
        <% else %>
          <%= for conv <- @conversations do %>
            <.link
              navigate={"/chat/#{conv.id}"}
              class={[
                "flex items-center gap-3.5 p-3 rounded-2xl transition-all outline-none group cursor-pointer",
                @active_conversation && @active_conversation.id == conv.id &&
                  "bg-slate-100 dark:bg-[#242427]",
                !(@active_conversation && @active_conversation.id == conv.id) &&
                  "hover:bg-slate-100/50 dark:hover:bg-white/[0.02]"
              ]}
            >
              <div class={[
                "relative size-11 rounded-full flex items-center justify-center shrink-0 text-white font-bold text-[13px]",
                (@active_conversation && @active_conversation.id == conv.id) ||
                  (conv.type == "group" &&
                     "bg-[#8B5CF6]"),
                !(@active_conversation && @active_conversation.id == conv.id) &&
                  conv.type != "group" &&
                  "bg-slate-200 dark:bg-[#2C2C2E] text-slate-600 dark:text-zinc-300 font-semibold"
              ]}>
                {conversation_avatar(conv, @current_user)}

                <%= if conv.type != "group" do %>
                  <% other =
                    Enum.find(conv.participants, fn p -> p.user_id != @current_user.id end) %>
                  <%= if other && Map.has_key?(@online_users, other.user_id) do %>
                    <div class="absolute bottom-0 right-0 size-2.5 bg-green-500 rounded-full border-2 border-[#F8FAFC] dark:border-[#161618]">
                    </div>
                  <% end %>
                <% end %>
              </div>

              <div class="flex-1 min-w-0 flex flex-col justify-center">
                <div class="flex items-center justify-between mb-0.5">
                  <h3 class="text-[14px] font-semibold text-slate-900 dark:text-white truncate pr-2">
                    {conversation_name(conv, @current_user)}
                  </h3>
                  <span class="text-[10px] text-slate-400 dark:text-zinc-500 font-medium shrink-0">
                    {if conv.messages != [],
                      do:
                        format_message_time(%{inserted_at: List.last(conv.messages).inserted_at}),
                      else: ""}
                  </span>
                </div>
                <div class="flex items-center justify-between">
                  <p class="text-[12px] text-slate-500 dark:text-zinc-400 truncate pr-2">
                    {last_message_preview(conv.messages)}
                  </p>
                  <%= if Map.get(@unread_counts, conv.id, 0) > 0 do %>
                    <span class="bg-[#8B5CF6] text-white text-[9px] font-bold px-1.5 py-[1px] rounded-full shrink-0">
                      {Map.get(@unread_counts, conv.id)}
                    </span>
                  <% end %>
                </div>
              </div>
            </.link>
          <% end %>
        <% end %>
      </div>
    </aside>
    
<!-- ── MAIN PANEL ─────────────────────────────────────────────────────── -->
    <main class="flex-1 flex flex-col min-w-0 bg-gradient-to-b from-white to-slate-50/50 dark:from-[#0E0E10] dark:to-[#111113] relative">
      <%= if @active_conversation do %>
        <!-- Main Header -->
        <div class="h-[68px] px-5 flex items-center justify-between bg-white/80 dark:bg-[#0E0E10]/90 backdrop-blur-md border-b border-slate-100 dark:border-white/[0.06] shrink-0 z-10">
          <div class="flex items-center gap-3.5">
            <div class={[
              "size-[40px] rounded-full flex items-center justify-center shrink-0 text-white font-bold text-[15px]",
              "bg-[#8B5CF6]"
            ]}>
              {conversation_avatar(@active_conversation, @current_user)}
            </div>
            <div class="flex flex-col justify-center h-full pt-1">
              <h2 class="text-[15px] font-semibold text-slate-900 dark:text-white leading-none">
                {conversation_name(@active_conversation, @current_user)}
              </h2>
              <div class="mt-1">
                <%= if @active_conversation.type == "group" do %>
                  <span class="text-[11px] text-slate-500 dark:text-zinc-500 font-medium tracking-wide">
                    {length(@active_conversation.participants)} members
                  </span>
                <% else %>
                  <% other =
                    Enum.find(@active_conversation.participants, fn p ->
                      p.user_id != @current_user.id
                    end) %>
                  <%= if other && Map.has_key?(@online_users, other.user_id) do %>
                    <span class="text-[11px] text-green-500 font-medium tracking-wide">
                      Online
                    </span>
                  <% else %>
                    <% last_seen =
                      if other, do: Helpdeskex.Chat.get_user_last_seen(other.user_id), else: nil %>
                    <span class="text-[11px] text-slate-500 dark:text-[#616161] font-medium tracking-wide">
                      {format_last_seen(last_seen)}
                    </span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-4 text-slate-400 dark:text-zinc-500">
            <button class="hover:text-slate-600 dark:hover:text-zinc-300 transition-colors">
              <.icon name="hero-magnifying-glass" class="w-5 h-5" />
            </button>
            <button
              phx-click="toggle_right_sidebar"
              class={["transition-colors", @show_right_sidebar && "text-[#8B5CF6]"]}
            >
              <.icon name="hero-document-text" class="w-5 h-5" />
            </button>
            <button class="hover:text-slate-600 dark:hover:text-zinc-300 transition-colors">
              <.icon name="hero-ellipsis-vertical" class="w-5 h-5" />
            </button>
          </div>
        </div>
        
<!-- Typing Indicator Animation -->
        <%= if @typing_users != [] do %>
          <div class="px-5 py-1.5 flex items-center gap-2">
            <div class="flex items-center gap-1.5 bg-white dark:bg-[#1C1C1F] border border-slate-100 dark:border-white/[0.07] rounded-full px-3 py-1.5 shadow-sm">
              <div class="flex gap-1 items-center">
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
              </div>
              <span class="text-[11px] font-medium text-slate-500 dark:text-zinc-400 ml-1">
                {Enum.map_join(@typing_users, ", ", & &1.name)} {if length(@typing_users) == 1,
                  do: "is",
                  else: "are"} typing
              </span>
            </div>
          </div>
        <% end %>
        
<!-- Messages stream -->
        <div
          class="flex-1 overflow-y-auto px-5 py-6 flex flex-col gap-1 scroll-smooth"
          id="chat-messages-wrap"
          phx-hook="ChatScroll"
        >
          <%= if @has_more_messages do %>
            <div class="flex justify-center mb-6">
              <button
                phx-click="load_more_messages"
                class="text-[11px] font-semibold px-4 py-1.5 rounded-full bg-white dark:bg-[#1C1C1F] border border-slate-200 dark:border-white/[0.08] text-slate-500 dark:text-zinc-400 hover:text-violet-600 hover:border-violet-200 dark:hover:text-violet-400 transition-all shadow-sm"
              >
                Load earlier messages
              </button>
            </div>
          <% end %>

          <div id="chat-messages" phx-update="stream" class="flex flex-col gap-1 mt-auto pb-6">
            <div
              :for={{id, msg} <- @streams.messages}
              id={id}
              class={[
                "flex items-end gap-2 max-w-[80%] sm:max-w-[70%] 2xl:max-w-[58%] group relative",
                msg.sender_id == @current_user.id && "ml-auto flex-row-reverse"
              ]}
            >
              
<!-- Other's Avatar -->
              <%= if msg.sender_id != @current_user.id do %>
                <div class={[
                  "size-8 rounded-full flex items-center justify-center text-[10px] font-bold shrink-0",
                  avatar_color(msg.sender_id)
                ]}>
                  {user_initials(msg.sender && msg.sender.full_name)}
                </div>
              <% end %>

              <div class={["flex flex-col", msg.sender_id == @current_user.id && "items-end"]}>
                <!-- Sender Name (Groups) -->
                <%= if @active_conversation.type == "group" && msg.sender_id != @current_user.id do %>
                  <span class="text-[10px] font-medium text-slate-400 dark:text-zinc-500 ml-3 mb-1 uppercase tracking-widest">
                    {msg.sender && msg.sender.full_name}
                  </span>
                <% end %>

                <div class="flex items-end gap-2 relative">
                  <!-- Message Bubble -->
                  <div class={[
                    "relative px-4 py-3 text-[14.5px] leading-[1.5] min-w-[100px] shadow-sm transition-transform hover:scale-[1.01] duration-200",
                    msg.sender_id == @current_user.id &&
                      "bg-gradient-to-br from-[#3797f0] via-[#7c3aed] to-[#8B5CF6] text-white shadow-lg rounded-[20px] shadow-violet-500/20",
                    msg.sender_id != @current_user.id &&
                      "bg-slate-100 dark:bg-[#262629] text-slate-800 dark:text-[#F5F5F5] rounded-[20px]",
                    msg.deleted_at &&
                      "!bg-transparent border border-dashed border-slate-300 dark:border-zinc-700 text-slate-400 !rounded-[20px] !shadow-none !scale-100"
                  ]}>
                    
<!-- Replied Message Preview -->
                    <%= if msg.reply_to do %>
                      <div class={[
                        "mb-2 p-2 rounded-xl text-xs border-l-2",
                        msg.sender_id == @current_user.id &&
                          "bg-white/10 border-white/40 text-[#E0D4FF]",
                        msg.sender_id != @current_user.id &&
                          "bg-white/50 dark:bg-[#161618] border-[#8B5CF6] text-slate-600 dark:text-zinc-400"
                      ]}>
                        <div class="font-semibold mb-0.5 opacity-90">
                          {msg.reply_to.sender && msg.reply_to.sender.full_name}
                        </div>
                        <div class="truncate opacity-80 text-[11px]">{msg.reply_to.body}</div>
                      </div>
                    <% end %>
                    
<!-- Body -->
                    <%= cond do %>
                      <% msg.deleted_at -> %>
                        <span class="italic text-[13px] opacity-70 flex items-center gap-1.5">
                          <.icon name="hero-no-symbol" class="w-3.5 h-3.5" /> Message deleted
                        </span>
                      <% msg.type == "file" -> %>
                        <% attachments = decode_attachments(msg.metadata) %>
                        <%= if attachments != [] do %>
                          <div class="flex flex-col gap-2">
                            <% has_text =
                              msg.body && String.trim(msg.body) != "" && msg.body != "File" %>
                            <%= if has_text do %>
                              <p class="text-[14px] leading-snug">{msg.body}</p>
                            <% end %>
                            <%= for att <- attachments do %>
                              <%= if att["type"] && String.starts_with?(att["type"], "image/") do %>
                                <a href={att["url"]} target="_blank" class="block">
                                  <img
                                    src={att["url"]}
                                    alt={att["name"]}
                                    class="max-w-[280px] max-h-[300px] w-auto h-auto rounded-xl object-cover cursor-zoom-in shadow-md"
                                    loading="lazy"
                                  />
                                </a>
                              <% else %>
                                <a
                                  href={att["url"]}
                                  target="_blank"
                                  class={[
                                    "flex items-center gap-2.5 px-3 py-2.5 rounded-xl transition-colors no-underline",
                                    msg.sender_id == @current_user.id &&
                                      "bg-white/15 hover:bg-white/25 text-white",
                                    msg.sender_id != @current_user.id &&
                                      "bg-slate-100 dark:bg-white/5 hover:bg-slate-200 dark:hover:bg-white/10 text-slate-800 dark:text-zinc-200"
                                  ]}
                                >
                                  <.icon
                                    name="hero-document-text"
                                    class="w-5 h-5 shrink-0 opacity-80"
                                  />
                                  <span class="text-[13px] font-medium truncate max-w-[180px]">
                                    {att["name"]}
                                  </span>
                                  <.icon
                                    name="hero-arrow-down-tray"
                                    class="w-4 h-4 shrink-0 opacity-60"
                                  />
                                </a>
                              <% end %>
                            <% end %>
                          </div>
                        <% else %>
                          <span>{msg.body}</span>
                        <% end %>
                      <% true -> %>
                        <span class="whitespace-pre-wrap break-words">{msg.body}</span>
                    <% end %>
                    
<!-- Reactions Display -->
                    <%= if Map.get(msg, :reactions) && msg.reactions != [] do %>
                      <div class={[
                        "flex flex-wrap gap-1 mt-1",
                        msg.sender_id == @current_user.id && "justify-end"
                      ]}>
                        <%= for {emoji, reactions} <- Enum.group_by(msg.reactions, & &1.emoji) do %>
                          <% count = length(reactions)
                          reacted_by_me = Enum.any?(reactions, &(&1.user_id == @current_user.id)) %>
                          <button
                            phx-click="toggle_reaction"
                            phx-value-message_id={msg.id}
                            phx-value-emoji={emoji}
                            class={[
                              "flex items-center justify-center w-6 h-6 rounded-full text-[13px] bg-white dark:bg-[#262629] border border-slate-100 dark:border-white/10 shadow-md transition-all hover:scale-110 active:scale-95 hover:z-40",
                              reacted_by_me &&
                                "bg-violet-100 border-violet-200 text-violet-700 dark:bg-violet-900/30 dark:border-violet-800 dark:text-violet-300",
                              !reacted_by_me &&
                                "bg-slate-50 border-slate-200 text-slate-600 dark:bg-[#1C1C1F] dark:border-white/10 dark:text-zinc-400 hover:border-slate-300"
                            ]}
                          >
                            <span>{emoji}</span>
                            <%= if count > 1 do %>
                              <span class="font-bold">{count}</span>
                            <% end %>
                          </button>
                        <% end %>
                      </div>
                    <% end %>
                    <!-- Meta (Time & Ticks) -->
                    <div class={[
                      "flex items-center justify-end gap-1 mt-1 -mb-1",
                      msg.sender_id == @current_user.id && "text-[#DCD5F9]",
                      msg.sender_id != @current_user.id && "text-slate-400 dark:text-[#616161]"
                    ]}>
                      <%= if msg.edited_at do %>
                        <span class="text-[9px] font-medium tracking-wide">(edited)</span>
                      <% end %>
                      <span class="text-[10px] font-medium tracking-wide">
                        {format_message_time(msg)}
                      </span>
                      <%= if msg.sender_id == @current_user.id && !msg.deleted_at do %>
                        <.icon name="hero-check" class="w-[11px] h-[11px] stroke-[3] ml-0.5" />
                      <% end %>
                    </div>
                  </div>
                  
<!-- Hover Actions -->
                  <%= if !msg.deleted_at do %>
                    <div class={[
                      "absolute -bottom-4 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-all duration-200 bg-white dark:bg-[#1C1C1F] border border-slate-100 dark:border-white/10 rounded-full px-1.5 py-1 shadow-xl z-10 hover:scale-105",
                      msg.sender_id == @current_user.id && "right-0",
                      msg.sender_id != @current_user.id && "left-0"
                    ]}>
                      <div class="flex items-center border-r border-slate-100 dark:border-white/5 pr-1 mr-1">
                        <%= for emoji <- ["👍", "❤️", "😂", "🔥", "😮"] do %>
                          <button
                            phx-click="toggle_reaction"
                            phx-value-message_id={msg.id}
                            phx-value-emoji={emoji}
                            class="p-1 hover:scale-125 transition-transform text-[15px]"
                          >
                            {emoji}
                          </button>
                        <% end %>
                      </div>
                      <div class="relative">
                        <button
                          phx-click="toggle_reaction_picker"
                          phx-value-message_id={msg.id}
                          class={["p-1 rounded-full transition-colors flex items-center justify-center h-6 w-6", 
                                 @active_reaction_picker == msg.id && "bg-violet-100 text-violet-600 dark:bg-violet-900/40 text-slate-400 hover:text-slate-700 dark:text-zinc-400 dark:hover:text-white"]}
                          title="More Reactions"
                        >
                          <.icon name={if @active_reaction_picker == msg.id, do: "hero-x-mark", else: "hero-plus"} class="w-3.5 h-3.5" />
                        </button>

                        <%= if @active_reaction_picker == msg.id do %>
                          <div 
                            class="absolute bottom-full mb-2 right-0 bg-white dark:bg-[#1C1C1F] border border-slate-100 dark:border-white/10 rounded-2xl shadow-2xl p-2 z-50 grid grid-cols-6 gap-1 min-w-[180px]"
                            phx-click-away="close_reaction_picker"
                          >
                            <% more_emojis = ["💯", "🙏", "👏", "🎉", "😢", "😡", "🤔", "👀", "✅", "❌", "🚀", "✨", "🙌", "💔", "🌟", "💡", "🎨", "🎭"] %>
                            <%= for e <- more_emojis do %>
                              <button 
                                phx-click="toggle_reaction" 
                                phx-value-message_id={msg.id} 
                                phx-value-emoji={e}
                                class="p-1.5 hover:bg-slate-100 dark:hover:bg-white/5 rounded-lg text-lg transition-transform hover:scale-125"
                              >
                                {e}
                              </button>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                      <button
                        phx-click="set_reply_to"
                        phx-value-message_id={msg.id}
                        class="p-1 rounded-full text-slate-400 hover:text-slate-700 dark:text-zinc-400 dark:hover:text-white transition-colors"
                        title="Reply"
                      >
                        <.icon name="hero-arrow-uturn-left" class="w-4 h-4" />
                      </button>
                      <button
                        phx-click="open_forward_modal"
                        phx-value-message_id={msg.id}
                        class="p-1 rounded-full text-slate-400 hover:text-slate-700 dark:text-zinc-400 dark:hover:text-white transition-colors"
                        title="Forward"
                      >
                        <.icon name="hero-arrow-uturn-right" class="w-4 h-4" />
                      </button>
                      <%= if msg.sender_id == @current_user.id do %>
                        <button
                          phx-click="start_edit"
                          phx-value-message_id={msg.id}
                          class="p-1 rounded-full text-slate-400 hover:text-slate-700 dark:text-zinc-400 dark:hover:text-white transition-colors"
                          title="Edit"
                        >
                          <.icon name="hero-pencil" class="w-4 h-4" />
                        </button>
                        <button
                          phx-click="delete_message"
                          phx-value-message_id={msg.id}
                          data-confirm="Delete message?"
                          class="p-1.5 rounded-full bg-white dark:bg-[#161618] text-slate-400 hover:text-red-500 dark:text-zinc-400 dark:hover:text-red-400 transition-colors"
                          title="Delete"
                        >
                          <.icon name="hero-trash" class="w-4 h-4" />
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
        
<!-- Input Area Wrapper -->
        <div class="px-4 pb-4 pt-2 bg-white/80 dark:bg-[#0E0E10]/90 backdrop-blur-md border-t border-slate-100 dark:border-white/[0.06] relative">
          
<!-- @Mentions Autocomplete -->
          <%= if @mention_query && @mention_results != [] do %>
            <div
              id="mention-results"
              class="absolute bottom-full left-10 mb-4 bg-white dark:bg-[#1E1E20] border border-slate-200 dark:border-white/10 rounded-2xl shadow-xl overflow-hidden w-64 z-50"
            >
              <%= for {user, idx} <- Enum.with_index(@mention_results) do %>
                <button
                  type="button"
                  phx-click="select_mention"
                  phx-value-user_id={user.id}
                  class={[
                    "w-full flex items-center gap-2.5 p-2.5 text-left transition-colors",
                    @mention_index == idx && "bg-slate-50 dark:bg-white/5",
                    "hover:bg-slate-50 dark:hover:bg-white/5"
                  ]}
                >
                  <div class="size-7 rounded-full bg-[#8B5CF6] text-white flex items-center justify-center text-[10px] font-bold">
                    {user_initials(user.full_name)}
                  </div>
                  <div class="flex-1 truncate">
                    <p class="text-xs font-semibold text-slate-900 dark:text-white truncate">
                      {user.full_name}
                    </p>
                    <p class="text-[10px] text-slate-500 truncate">{user.email}</p>
                  </div>
                </button>
              <% end %>
            </div>
          <% end %>
          
<!-- Emoji Picker Container -->
          <div
            id="emoji-picker-container"
            class="hidden absolute bottom-full right-10 mb-4 z-50 shadow-2xl border border-slate-200 dark:border-white/10 rounded-2xl overflow-hidden"
          >
          </div>
          
<!-- Uploads Preview -->
          <%= if @uploads.attachments.entries != [] do %>
            <div class="px-4 py-3 bg-slate-100 dark:bg-[#161618] rounded-t-xl flex flex-wrap gap-3 mx-4 border-b border-slate-200 dark:border-white/5">
              <%= for entry <- @uploads.attachments.entries do %>
                <div class="relative group size-16 bg-white dark:bg-[#1E1E20] rounded-lg border border-slate-200 dark:border-white/10 flex items-center justify-center overflow-hidden">
                  <%= if String.starts_with?(entry.client_type, "image") do %>
                    <.live_img_preview entry={entry} class="object-cover w-full h-full" />
                  <% else %>
                    <.icon name="hero-document-text" class="w-8 h-8 text-slate-400" />
                  <% end %>
                  
<!-- Progress bar -->
                  <div
                    class="absolute bottom-0 left-0 h-1 bg-indigo-500 transition-all"
                    style={"width: #{entry.progress}%"}
                  >
                  </div>

                  <button
                    type="button"
                    phx-click="cancel_upload"
                    phx-value-ref={entry.ref}
                    class="absolute top-1 right-1 p-0.5 rounded-full bg-black/50 text-white opacity-0 group-hover:opacity-100 transition-opacity"
                  >
                    <.icon name="hero-x-mark" class="w-3 h-3" />
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
          
<!-- Reply Indicator -->
          <%= if @reply_to do %>
            <div class="px-4 py-2 bg-slate-100 dark:bg-[#161618] rounded-t-xl flex items-center justify-between mx-4 overflow-hidden border-b border-slate-200 dark:border-white/5">
              <div class="flex-1 min-w-0 pl-1 border-l-2 border-[#8B5CF6]">
                <p class="text-[11px] font-bold text-[#8B5CF6] mb-0.5 ml-2">
                  Replying to {(@reply_to.sender && @reply_to.sender.full_name) || "Unknown"}
                </p>
                <p class="text-xs text-slate-500 dark:text-zinc-500 truncate ml-2">
                  {String.slice(@reply_to.body || "", 0, 80)}
                </p>
              </div>
              <button
                phx-click="cancel_reply"
                class="text-slate-400 hover:text-slate-600 dark:hover:text-zinc-300 p-1"
              >
                <.icon name="hero-x-mark" class="w-4 h-4" />
              </button>
            </div>
          <% end %>
          
<!-- Edit Indicator -->
          <%= if @editing_message do %>
            <div class="px-4 py-2 bg-slate-100 dark:bg-[#161618] rounded-t-xl flex items-center justify-between mx-4 overflow-hidden border-b border-slate-200 dark:border-white/5">
              <div class="flex-1 min-w-0 pl-1 border-l-2 border-amber-500">
                <p class="text-[11px] font-bold text-amber-600 dark:text-amber-500 mb-0.5 ml-2">
                  Editing message
                </p>
                <p class="text-xs text-slate-500 dark:text-zinc-500 truncate ml-2">
                  {String.slice(@editing_message.body || "", 0, 80)}
                </p>
              </div>
              <button
                phx-click="cancel_edit"
                class="text-slate-400 hover:text-slate-600 dark:hover:text-zinc-300 p-1"
              >
                <.icon name="hero-x-mark" class="w-4 h-4" />
              </button>
            </div>
          <% end %>

          <%!-- Premium Chat Input --%>
          <form
            id="chat-input-form"
            phx-submit={if @editing_message, do: "save_edit", else: "send_message"}
            phx-change="validate_upload"
            class={[
              "flex items-end gap-2 px-3 py-2 bg-slate-100 dark:bg-[#262629] border-none rounded-[28px] shadow-sm transition-all duration-200 mx-auto max-w-[95%]",
              (@reply_to || @editing_message || @uploads.attachments.entries != []) &&
                "rounded-t-none"
            ]}
          >
            <%!-- Attachment Button --%>
            <label
              id="attachment-label"
              class="flex items-center justify-center w-9 h-9 mb-[2px] shrink-0 rounded-xl text-slate-400 dark:text-zinc-500 hover:text-violet-600 dark:hover:text-violet-400 hover:bg-violet-50 dark:hover:bg-violet-500/10 transition-all cursor-pointer"
              title="Attach file"
            >
              <.icon name="hero-paper-clip" class="w-[18px] h-[18px]" />
              <div class="hidden">
                <.live_file_input upload={@uploads.attachments} />
              </div>
            </label>

            <%!-- Emoji Button --%>
            <button
              id="emoji-picker-btn"
              type="button"
              class="flex items-center justify-center w-9 h-9 mb-[2px] shrink-0 rounded-xl text-slate-400 dark:text-zinc-500 hover:text-violet-600 dark:hover:text-violet-400 hover:bg-violet-50 dark:hover:bg-violet-500/10 transition-all"
              title="Emoji"
            >
              <.icon name="hero-face-smile" class="w-[18px] h-[18px]" />
            </button>

            <%!-- Divider --%>
            

            <%!-- Text Input --%>
            <textarea
              id="chat-msg-input"
              name="body"
              placeholder={if @editing_message, do: "Edit message...", else: "Write a message…"}
              class="flex-1 bg-transparent border-none outline-none focus:outline-none focus:ring-0 px-2 py-2 text-[14px] leading-[1.6] text-slate-800 dark:text-white placeholder:text-slate-400 dark:placeholder:text-zinc-600 min-w-0 font-normal resize-none overflow-hidden max-h-32"
              autocomplete="off"
              phx-hook="ChatInput"
              rows="1"
              autofocus
            >{if @editing_message, do: @editing_message.body, else: @message_input}</textarea>

            <%!-- Send Button --%>
            <button
              type="submit"
              id="chat-send-btn"
              class={[
                "flex items-center justify-center w-9 h-9 shrink-0 rounded-xl transition-all duration-150 active:scale-90",
                if(
                  String.trim(@message_input || "") == "" && @uploads.attachments.entries == [] &&
                    !@editing_message,
                  do: "text-slate-400 dark:text-zinc-600 cursor-not-allowed",
                  else:
                    "bg-[#8B5CF6] hover:bg-[#7c3aed] text-white shadow-md shadow-violet-500/25 hover:shadow-violet-500/40"
                )
              ]}
              disabled={
                String.trim(@message_input || "") == "" && @uploads.attachments.entries == [] &&
                  !@editing_message
              }
            >
              <.icon
                name="hero-paper-airplane"
                class="w-[17px] h-[17px] -rotate-[40deg] translate-x-px -translate-y-px"
              />
            </button>
          </form>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="flex-1 flex items-center justify-center">
          <div class="max-w-md text-center px-6 opacity-40">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">HelpdeskEx Chat</h2>
            <p class="text-sm text-slate-500 dark:text-zinc-400">
              Select a conversation.
            </p>
          </div>
        </div>
      <% end %>
    </main>
    
<!-- ── RIGHT SIDEBAR (PRODUCTIVITY) ───────────────────────────────────── -->
    <%= if @show_right_sidebar && @active_conversation do %>
      <aside class="w-[300px] border-l border-slate-200 dark:border-[#1E1E20] bg-slate-50 dark:bg-[#161618] flex flex-col shrink-0">
        <div class="h-[72px] px-5 flex items-center justify-between border-b border-slate-200 dark:border-white/5">
          <h3 class="text-[15px] font-bold text-slate-900 dark:text-white">Productivity</h3>
          <button phx-click="toggle_right_sidebar" class="text-slate-400 hover:text-slate-600">
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>
        
<!-- Tabs -->
        <div class="flex p-2 gap-1">
          <button
            phx-click="set_active_tab"
            phx-value-tab="todos"
            class={[
              "flex-1 py-1.5 text-[11px] font-bold uppercase tracking-wider rounded-lg transition-all",
              @active_tab == "todos" && "bg-white dark:bg-[#1E1E20] text-[#8B5CF6] shadow-sm",
              @active_tab != "todos" && "text-slate-500 hover:text-slate-700"
            ]}
          >
            TODOs
          </button>
          <button
            phx-click="set_active_tab"
            phx-value-tab="notes"
            class={[
              "flex-1 py-1.5 text-[11px] font-bold uppercase tracking-wider rounded-lg transition-all",
              @active_tab == "notes" && "bg-white dark:bg-[#1E1E20] text-[#8B5CF6] shadow-sm",
              @active_tab != "notes" && "text-slate-500 hover:text-slate-700"
            ]}
          >
            Notes
          </button>
        </div>

        <div class="flex-1 overflow-y-auto p-4">
          <%= if @active_tab == "todos" do %>
            <div id="todos-list" phx-update="stream" class="space-y-3">
              <div
                :for={{id, todo} <- @streams.todos}
                id={id}
                class="flex items-start gap-3 p-3 bg-white dark:bg-[#1E1E20] rounded-xl border border-slate-100 dark:border-white/5 group"
              >
                <button
                  phx-click="toggle_todo_status"
                  phx-value-id={todo.id}
                  class={[
                    "size-5 mt-0.5 rounded border-2 shrink-0 flex items-center justify-center transition-colors",
                    todo.is_completed && "bg-green-500 border-green-500 text-white",
                    !todo.is_completed && "border-slate-300 dark:border-zinc-700"
                  ]}
                >
                  <%= if todo.is_completed do %>
                    <.icon name="hero-check" class="w-3.5 h-3.5 stroke-[3]" />
                  <% end %>
                </button>
                <span class={[
                  "text-[13px] font-medium leading-tight",
                  todo.is_completed && "text-slate-400 line-through",
                  !todo.is_completed && "text-slate-700 dark:text-zinc-200"
                ]}>
                  {todo.title}
                </span>
              </div>
              <div class="hidden only:block text-center py-10">
                <p class="text-xs text-slate-400">No tasks yet.</p>
              </div>
            </div>
          <% else %>
            <div id="notes-list" phx-update="stream" class="space-y-4">
              <div
                :for={{id, note} <- @streams.notes}
                id={id}
                class="p-3 bg-white dark:bg-[#1E1E20] rounded-xl border border-slate-100 dark:border-white/5"
              >
                <p class="text-[13px] text-slate-700 dark:text-zinc-200 whitespace-pre-wrap">
                  {note.body}
                </p>
                <span class="text-[10px] text-slate-400 mt-2 block">
                  {format_message_time(note)}
                </span>
              </div>
              <div class="hidden only:block text-center py-10">
                <p class="text-xs text-slate-400">No notes yet.</p>
              </div>
            </div>
          <% end %>
        </div>
        
        <!-- Productivity Input Area -->
        <div class="px-6 py-4 bg-transparent">
          <form
            phx-submit={if @active_tab == "todos", do: "save_todo", else: "save_note"}
            id="productivity-form"
            phx-hook="ResetForm"
          >
            <div class="relative group">
              <input
                type="text"
                name="content"
                placeholder={
                  if @active_tab == "todos", do: "Add a new task...", else: "Take a quick note..."
                }
                class="w-full bg-slate-50 dark:bg-[#0E0E10] border border-slate-200 dark:border-white/10 rounded-xl pl-3 pr-10 py-2 text-sm text-slate-900 dark:text-zinc-200 placeholder-slate-400 dark:placeholder-zinc-500 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-all shadow-inner"
                autocomplete="off"
              />
              <button
                type="submit"
                class="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 text-slate-400 hover:text-violet-500 transition-colors"
              >
                <.icon name="hero-plus-circle" class="w-5 h-5" />
              </button>
            </div>
          </form>
        </div>
      </aside>
    <% end %>
  </div>
  
<!-- ── MODALS ───────────────────────────────────────────────────────────── -->

  <%= if @show_new_chat_modal do %>
    <div
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm"
      phx-click="close_new_chat"
    >
      <div
        class="bg-white dark:bg-[#1E1E20] rounded-[24px] w-full max-w-md shadow-2xl border border-slate-200 dark:border-white/5 overflow-hidden"
        phx-click-away="close_new_chat"
      >
        <div class="p-5 flex items-center justify-between border-b border-slate-100 dark:border-white/5">
          <h3 class="text-[17px] font-bold text-slate-900 dark:text-white">New direct message</h3>
          <button
            phx-click="close_new_chat"
            class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-white/5 text-slate-400 transition-colors"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <div class="p-4 border-b border-slate-100 dark:border-white/5">
          <div class="relative">
            <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-slate-400">
              <.icon name="hero-magnifying-glass" class="w-4 h-4" />
            </div>
            <input
              type="text"
              placeholder="Search team members..."
              phx-keyup="search_users"
              phx-debounce="200"
              name="query"
              autofocus
              class="w-full bg-slate-50 dark:bg-[#161618] border border-slate-200 dark:border-white/5 rounded-2xl py-3 pl-10 pr-4 text-[14px] text-slate-900 dark:text-white placeholder:text-slate-500 focus:ring-1 focus:ring-[#8B5CF6]/50 focus:border-[#8B5CF6]/50"
            />
          </div>
        </div>

        <div class="max-h-[60vh] overflow-y-auto p-2">
          <%= for user <- filtered_users(@tenant_users, @search_query) do %>
            <button
              phx-click="start_direct_chat"
              phx-value-user_id={user.id}
              class="w-full flex items-center gap-3.5 p-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-white/[0.02] transition-colors text-left group"
            >
              <div class="size-10 flex-shrink-0 rounded-full bg-slate-200 dark:bg-[#2C2C2E] text-slate-600 dark:text-zinc-300 font-bold text-[13px] flex items-center justify-center">
                {user_initials(user.full_name)}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[14px] font-semibold text-slate-900 dark:text-white truncate group-hover:text-[#8B5CF6] transition-colors">
                  {user.full_name}
                </p>
                <p class="text-[12px] text-slate-500 dark:text-zinc-500 truncate">{user.email}</p>
              </div>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @show_group_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm">
      <div class="bg-white dark:bg-[#1E1E20] rounded-[24px] w-full max-w-md shadow-2xl border border-slate-200 dark:border-white/5 overflow-hidden flex flex-col max-h-[85vh]">
        <div class="p-5 flex items-center justify-between border-b border-slate-100 dark:border-white/5">
          <h3 class="text-[17px] font-bold text-slate-900 dark:text-white">Create a Group</h3>
          <button
            phx-click="close_group_modal"
            class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-white/5 text-slate-400 transition-colors"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <div class="p-5 border-b border-slate-100 dark:border-white/5 space-y-3">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 dark:text-zinc-500 uppercase tracking-widest mb-2">
              Group Name
            </label>
            <input
              type="text"
              placeholder="e.g. Project Phoenix"
              phx-keyup="set_group_name"
              phx-debounce="100"
              name="name"
              class="w-full bg-slate-50 dark:bg-[#161618] border border-slate-200 dark:border-white/5 rounded-2xl px-4 py-3 text-[14px] text-slate-900 dark:text-white focus:ring-1 focus:ring-[#8B5CF6]/50 focus:border-[#8B5CF6]/50 shadow-none font-medium"
              autofocus
            />
          </div>
        </div>

        <div class="flex-1 overflow-y-auto p-4 space-y-1">
          <div class="px-2 pb-2 text-[11px] font-bold text-slate-500 dark:text-zinc-500 uppercase tracking-widest">
            Select Members
          </div>
          <%= for user <- @tenant_users do %>
            <button
              phx-click="toggle_member"
              phx-value-user_id={user.id}
              class={[
                "w-full flex items-center gap-3.5 p-3 rounded-2xl transition-all text-left border",
                user.id in @selected_members &&
                  "bg-slate-100 dark:bg-[#242427] border-transparent",
                user.id not in @selected_members &&
                  "hover:bg-slate-50 dark:hover:bg-white/[0.02] border-transparent"
              ]}
            >
              <div class="size-9 flex-shrink-0 rounded-full bg-slate-200 dark:bg-[#2C2C2E] text-slate-600 dark:text-zinc-300 font-bold text-xs flex items-center justify-center">
                {user_initials(user.full_name)}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[14px] font-semibold text-slate-900 dark:text-white truncate">
                  {user.full_name}
                </p>
              </div>
              <div class={[
                "size-5 rounded-full border flex items-center justify-center shrink-0 transition-colors",
                user.id in @selected_members && "bg-[#8B5CF6] border-[#8B5CF6] text-white",
                user.id not in @selected_members &&
                  "bg-transparent border-slate-300 dark:border-[#38383B]"
              ]}>
                <%= if user.id in @selected_members do %>
                  <.icon name="hero-check" class="w-3.5 h-3.5 stroke-[3]" />
                <% end %>
              </div>
            </button>
          <% end %>
        </div>

        <div class="p-5 border-t border-slate-100 dark:border-white/5 bg-slate-50/50 dark:bg-[#161618] flex items-center justify-between">
          <span class="text-[13px] font-medium text-slate-500 dark:text-zinc-400">
            {length(@selected_members)} member{if length(@selected_members) != 1, do: "s"} selected
          </span>
          <button
            phx-click="create_group"
            disabled={length(@selected_members) < 2}
            class="px-6 py-2.5 rounded-full bg-[#8B5CF6] disabled:opacity-50 disabled:cursor-not-allowed hover:bg-[#7e53ea] text-white font-bold text-[14px] transition-all"
          >
            Create Group
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @show_forward_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm">
      <div class="bg-white dark:bg-[#1E1E20] rounded-[24px] w-full max-w-sm shadow-2xl border border-slate-200 dark:border-white/5 overflow-hidden flex flex-col max-h-[70vh]">
        <div class="p-5 flex items-center justify-between border-b border-slate-100 dark:border-white/5">
          <h3 class="text-[17px] font-bold text-slate-900 dark:text-white">Forward Message</h3>
          <button
            phx-click="close_forward_modal"
            class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-white/5 text-slate-400 transition-colors"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <div class="flex-1 overflow-y-auto p-4 space-y-1">
          <div class="px-2 pb-2 text-[11px] font-bold text-slate-500 dark:text-zinc-500 uppercase tracking-widest">
            Select Destination
          </div>
          <%= for conv <- @conversations do %>
            <button
              phx-click="forward_message"
              phx-value-to_conversation_id={conv.id}
              class="w-full flex items-center gap-3.5 p-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-white/[0.02] transition-colors text-left group border border-transparent"
            >
              <div class="size-9 flex-shrink-0 rounded-full bg-slate-200 dark:bg-[#2C2C2E] text-slate-600 dark:text-zinc-300 font-bold text-xs flex items-center justify-center">
                {user_initials(conversation_name(conv, @current_user))}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[14px] font-semibold text-slate-900 dark:text-white truncate group-hover:text-[#8B5CF6] transition-colors">
                  {conversation_name(conv, @current_user)}
                </p>
                <p class="text-[10px] text-slate-500 dark:text-zinc-500 uppercase tracking-wider font-bold">
                  {conv.type}
                </p>
              </div>
              <div class="text-slate-300 dark:text-[#38383B]">
                <.icon name="hero-chevron-right" class="w-4 h-4" />
              </div>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>

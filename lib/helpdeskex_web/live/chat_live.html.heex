<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_view="chat"
  sidebar_collapsed={@sidebar_collapsed}
  stats={@stats}
  current_scope={@current_scope}
  theme={@theme}
>
  <meta id="chat-token" content={@chat_token} />
  <meta id="current-user-id" content={@current_user.id} />

  <div class="flex h-full w-full bg-white dark:bg-[#0E0E10] overflow-hidden relative font-sans">
    
    <!-- ── SIDEBAR ────────────────────────────────────────────────────────── -->
    <aside class="w-[320px] sm:w-[320px] lg:w-[350px] flex-shrink-0 flex flex-col border-r border-slate-200 dark:border-[#1E1E20] bg-slate-50 dark:bg-[#161618] z-20">
      
      <!-- Sidebar Header -->
      <div class="h-[64px] px-5 flex items-center justify-between shrink-0">
        <h2 class="text-[17px] font-bold text-slate-900 dark:text-white tracking-tight">Messages</h2>
        <div class="flex items-center gap-2 text-slate-400 dark:text-zinc-500">
          <button phx-click="open_group_modal" class="p-1.5 rounded-lg hover:text-slate-700 hover:bg-slate-200 dark:hover:text-zinc-300 dark:hover:bg-white/5 transition-colors" title="New Group">
            <.icon name="hero-user-group" class="w-5 h-5"/>
          </button>
          <button phx-click="open_new_chat" class="p-1.5 rounded-lg hover:text-slate-700 hover:bg-slate-200 dark:hover:text-zinc-300 dark:hover:bg-white/5 transition-colors" title="New Direct Message">
            <.icon name="hero-pencil-square" class="w-5 h-5"/>
          </button>
        </div>
      </div>

      <!-- Search -->
      <div class="px-5 pb-3 shrink-0">
        <div class="relative group">
          <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-slate-400 dark:text-zinc-500">
            <.icon name="hero-magnifying-glass" class="w-4 h-4"/>
          </div>
          <input
            type="text"
            placeholder="Search conversations..."
            class="w-full bg-white dark:bg-[#1E1E20] border border-slate-200 dark:border-white/5 rounded-full py-2 pl-10 pr-4 text-[13px] text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-indigo-500/50 dark:focus:border-[#38383B] transition-all shadow-none"
          />
        </div>
      </div>

      <!-- Conversation List -->
      <div class="flex-1 overflow-y-auto px-3 py-1 space-y-0.5">
        <%= if @conversations == [] do %>
          <div class="flex flex-col items-center justify-center pt-10 text-center px-4">
            <p class="text-xs text-slate-500 dark:text-zinc-500">No messages yet.</p>
          </div>
        <% else %>
          <%= for conv <- @conversations do %>
            <.link
              navigate={"/chat/#{conv.id}"}
              class={[
                "flex items-center gap-3.5 p-3 rounded-2xl transition-all outline-none group cursor-pointer",
                @active_conversation && @active_conversation.id == conv.id
                  && "bg-slate-100 dark:bg-[#242427]",
                !(@active_conversation && @active_conversation.id == conv.id)
                  && "hover:bg-slate-100/50 dark:hover:bg-white/[0.02]"
              ]}
            >
              <div class={[
                "relative size-11 rounded-full flex items-center justify-center shrink-0 text-white font-bold text-[13px]",
                 (@active_conversation && @active_conversation.id == conv.id) || conv.type == "group" 
                  && "bg-[#8B5CF6]",
                 !(@active_conversation && @active_conversation.id == conv.id) && conv.type != "group" 
                  && "bg-slate-200 dark:bg-[#2C2C2E] text-slate-600 dark:text-zinc-300 font-semibold"
              ]}>
                {conversation_avatar(conv, @current_user)}
                
                <%= if conv.type != "group" do %>
                   <% other = Enum.find(conv.participants, fn p -> p.user_id != @current_user.id end) %>
                   <%= if other && Map.has_key?(@online_users, other.user_id) do %>
                     <div class="absolute bottom-0 right-0 size-2.5 bg-green-500 rounded-full border-2 border-[#F8FAFC] dark:border-[#161618]"></div>
                   <% end %>
                <% end %>
              </div>

              <div class="flex-1 min-w-0 flex flex-col justify-center">
                <div class="flex items-center justify-between mb-0.5">
                  <h3 class="text-[14px] font-semibold text-slate-900 dark:text-white truncate pr-2">
                    {conversation_name(conv, @current_user)}
                  </h3>
                  <span class="text-[10px] text-slate-400 dark:text-zinc-500 font-medium shrink-0">
                    {if conv.messages != [], do: format_message_time(%{inserted_at: List.last(conv.messages).inserted_at}), else: ""}
                  </span>
                </div>
                <div class="flex items-center justify-between">
                  <p class="text-[12px] text-slate-500 dark:text-zinc-400 truncate pr-2">
                    {last_message_preview(conv.messages)}
                  </p>
                  <%= if Map.get(@unread_counts, conv.id, 0) > 0 do %>
                    <span class="bg-[#8B5CF6] text-white text-[9px] font-bold px-1.5 py-[1px] rounded-full shrink-0">
                      {Map.get(@unread_counts, conv.id)}
                    </span>
                  <% end %>
                </div>
              </div>
            </.link>
          <% end %>
        <% end %>
      </div>
    </aside>

    <!-- ── MAIN PANEL ─────────────────────────────────────────────────────── -->
    <main class="flex-1 flex flex-col min-w-0 bg-white dark:bg-[#0E0E10] relative">
      <%= if @active_conversation do %>
        <!-- Main Header -->
        <div class="h-[72px] px-6 flex items-center justify-between bg-white dark:bg-[#0E0E10] shrink-0 z-10">
          <div class="flex items-center gap-3.5">
            <div class={[
              "size-[40px] rounded-full flex items-center justify-center shrink-0 text-white font-bold text-[15px]",
              "bg-[#8B5CF6]"
            ]}>
              {conversation_avatar(@active_conversation, @current_user)}
            </div>
            <div class="flex flex-col justify-center h-full pt-1">
              <h2 class="text-[15px] font-semibold text-slate-900 dark:text-white leading-none">
                {conversation_name(@active_conversation, @current_user)}
              </h2>
              <div class="mt-1">
                <%= if @active_conversation.type == "group" do %>
                  <span class="text-[11px] text-slate-500 dark:text-zinc-500 font-medium tracking-wide">
                    {length(@active_conversation.participants)} members
                  </span>
                <% else %>
                  <% other = Enum.find(@active_conversation.participants, fn p -> p.user_id != @current_user.id end) %>
                  <%= if other && Map.has_key?(@online_users, other.user_id) do %>
                    <span class="text-[11px] text-green-500 font-medium tracking-wide">Online</span>
                  <% else %>
                    <% last_seen = if other, do: Helpdeskex.Chat.get_user_last_seen(other.user_id), else: nil %>
                    <span class="text-[11px] text-slate-500 dark:text-[#616161] font-medium tracking-wide">{format_last_seen(last_seen)}</span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
          
          <div class="flex items-center gap-4 text-slate-400 dark:text-zinc-500">
            <button class="hover:text-slate-600 dark:hover:text-zinc-300 transition-colors">
              <.icon name="hero-magnifying-glass" class="w-5 h-5"/>
            </button>
            <button class="hover:text-slate-600 dark:hover:text-zinc-300 transition-colors">
              <.icon name="hero-ellipsis-vertical" class="w-5 h-5"/>
            </button>
          </div>
        </div>

        <!-- Messages stream -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 flex flex-col pt-10" id="chat-messages-wrap" phx-hook="ChatScroll">
          
          <%= if @has_more_messages do %>
            <div class="flex justify-center mb-6">
              <button phx-click="load_more_messages" class="text-xs font-semibold px-4 py-1.5 rounded-full bg-slate-100 dark:bg-[#1E1E20] text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-200 transition-colors">
                Load earlier messages
              </button>
            </div>
          <% end %>

          <div id="chat-messages" phx-update="stream" class="flex flex-col gap-6 mt-auto">
            <div
              :for={{id, msg} <- @streams.messages}
              id={id}
              class={[
                "flex max-w-[85%] sm:max-w-[75%] 2xl:max-w-[60%] group",
                msg.sender_id == @current_user.id && "ml-auto flex-row-reverse"
              ]}
            >
              
              <!-- Other's Avatar -->
              <%= if msg.sender_id != @current_user.id do %>
                <div class="size-8 rounded-full bg-slate-200 dark:bg-[#2C2C2E] text-slate-600 dark:text-zinc-300 flex items-center justify-center text-[10px] font-bold shrink-0 mt-auto mr-3 border border-white dark:border-transparent">
                  {user_initials(msg.sender && msg.sender.full_name)}
                </div>
              <% end %>

              <div class={["flex flex-col", msg.sender_id == @current_user.id && "items-end"]}>
                <!-- Sender Name (Groups) -->
                <%= if @active_conversation.type == "group" && msg.sender_id != @current_user.id do %>
                  <span class="text-[11px] font-semibold text-slate-500 dark:text-zinc-500 ml-1 mb-1.5 tracking-wide">
                    {msg.sender && msg.sender.full_name}
                  </span>
                <% end %>

                <div class="flex items-end gap-2 relative">
                  <!-- Message Bubble -->
                  <div class={[
                    "relative px-4 py-3 text-[14px] leading-[1.5] min-w-[100px]",
                    msg.sender_id == @current_user.id 
                      && "bg-[#8B5CF6] text-white rounded-[20px] rounded-br-[4px]",
                    msg.sender_id != @current_user.id 
                      && "bg-slate-100 dark:bg-[#1E1E20] text-slate-800 dark:text-[#E4E4E5] rounded-[20px] rounded-bl-[4px]",
                    msg.deleted_at && "bg-transparent border border-dashed border-slate-300 dark:border-zinc-700 text-slate-400 !rounded-[20px]"
                  ]}>
                    
                    <!-- Replied Message Preview -->
                    <%= if msg.reply_to do %>
                      <div class={[
                        "mb-2 p-2 rounded-xl text-xs border-l-2",
                        msg.sender_id == @current_user.id 
                          && "bg-white/10 border-white/40 text-[#E0D4FF]",
                        msg.sender_id != @current_user.id 
                          && "bg-white/50 dark:bg-[#161618] border-[#8B5CF6] text-slate-600 dark:text-zinc-400"
                      ]}>
                        <div class="font-semibold mb-0.5 opacity-90">{msg.reply_to.sender && msg.reply_to.sender.full_name}</div>
                        <div class="truncate opacity-80 text-[11px]">{msg.reply_to.body}</div>
                      </div>
                    <% end %>

                    <!-- Body -->
                    <%= cond do %>
                      <% msg.deleted_at -> %>
                        <span class="italic text-[13px] opacity-70">Message deleted</span>
                      <% true -> %>
                        <span>{msg.body}</span>
                    <% end %>

                    <!-- Meta (Time & Ticks) -->
                    <div class={[
                      "flex items-center justify-end gap-1 mt-1 -mb-1",
                      msg.sender_id == @current_user.id && "text-[#DCD5F9]",
                      msg.sender_id != @current_user.id && "text-slate-400 dark:text-[#616161]"
                    ]}>
                      <%= if msg.edited_at do %>
                        <span class="text-[9px] font-medium tracking-wide">(edited)</span>
                      <% end %>
                      <span class="text-[10px] font-medium tracking-wide">
                        {format_message_time(msg)}
                      </span>
                      <%= if msg.sender_id == @current_user.id && !msg.deleted_at do %>
                         <.icon name="hero-check" class="w-[11px] h-[11px] stroke-[3] ml-0.5"/> 
                      <% end %>
                    </div>
                  </div>

                  <!-- Hover Actions -->
                  <%= if !msg.deleted_at do %>
                    <div class={[
                      "absolute top-1/2 -translate-y-1/2 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200",
                      msg.sender_id == @current_user.id && "right-full mr-2",
                      msg.sender_id != @current_user.id && "left-full ml-2"
                    ]}>
                      <button phx-click="set_reply_to" phx-value-message_id={msg.id} class="p-1.5 rounded-full bg-white dark:bg-[#161618] text-slate-400 hover:text-slate-700 dark:text-zinc-400 dark:hover:text-white transition-colors" title="Reply">
                        <.icon name="hero-arrow-uturn-left" class="w-4 h-4"/>
                      </button>
                      <%= if msg.sender_id == @current_user.id do %>
                        <button phx-click="start_edit" phx-value-message_id={msg.id} class="p-1.5 rounded-full bg-white dark:bg-[#161618] text-slate-400 hover:text-slate-700 dark:text-zinc-400 dark:hover:text-white transition-colors" title="Edit">
                          <.icon name="hero-pencil" class="w-4 h-4"/>
                        </button>
                        <button phx-click="delete_message" phx-value-message_id={msg.id} data-confirm="Delete message?" class="p-1.5 rounded-full bg-white dark:bg-[#161618] text-slate-400 hover:text-red-500 dark:text-zinc-400 dark:hover:text-red-400 transition-colors" title="Delete">
                          <.icon name="hero-trash" class="w-4 h-4"/>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Input Area Wrapper -->
        <div class="px-6 pb-6 pt-2 bg-white dark:bg-[#0E0E10]">
          
          <!-- Uploads Preview -->
          <%= if @uploads.attachments.entries != [] do %>
            <div class="px-4 py-3 bg-slate-100 dark:bg-[#161618] rounded-t-xl flex flex-wrap gap-3 mx-4 border-b border-slate-200 dark:border-white/5">
              <%= for entry <- @uploads.attachments.entries do %>
                <div class="relative group size-16 bg-white dark:bg-[#1E1E20] rounded-lg border border-slate-200 dark:border-white/10 flex items-center justify-center overflow-hidden">
                  <%= if String.starts_with?(entry.client_type, "image") do %>
                    <.live_img_preview entry={entry} class="object-cover w-full h-full" />
                  <% else %>
                    <.icon name="hero-document-text" class="w-8 h-8 text-slate-400"/>
                  <% end %>
                  
                  <!-- Progress bar -->
                  <div class="absolute bottom-0 left-0 h-1 bg-indigo-500 transition-all" style={"width: #{entry.progress}%"}></div>

                  <button type="button" phx-click="cancel_upload" phx-value-ref={entry.ref} class="absolute top-1 right-1 p-0.5 rounded-full bg-black/50 text-white opacity-0 group-hover:opacity-100 transition-opacity">
                    <.icon name="hero-x-mark" class="w-3 h-3"/>
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Reply Indicator -->
          <%= if @reply_to do %>
            <div class="px-4 py-2 bg-slate-100 dark:bg-[#161618] rounded-t-xl flex items-center justify-between mx-4 overflow-hidden border-b border-slate-200 dark:border-white/5">
               <div class="flex-1 min-w-0 pl-1 border-l-2 border-[#8B5CF6]">
                 <p class="text-[11px] font-bold text-[#8B5CF6] mb-0.5 ml-2">
                   Replying to {(@reply_to.sender && @reply_to.sender.full_name) || "Unknown"}
                 </p>
                 <p class="text-xs text-slate-500 dark:text-zinc-500 truncate ml-2">
                   {String.slice(@reply_to.body || "", 0, 80)}
                 </p>
               </div>
               <button phx-click="cancel_reply" class="text-slate-400 hover:text-slate-600 dark:hover:text-zinc-300 p-1">
                 <.icon name="hero-x-mark" class="w-4 h-4"/>
               </button>
            </div>
          <% end %>

          <!-- Edit Indicator -->
          <%= if @editing_message do %>
            <div class="px-4 py-2 bg-slate-100 dark:bg-[#161618] rounded-t-xl flex items-center justify-between mx-4 overflow-hidden border-b border-slate-200 dark:border-white/5">
               <div class="flex-1 min-w-0 pl-1 border-l-2 border-amber-500">
                 <p class="text-[11px] font-bold text-amber-600 dark:text-amber-500 mb-0.5 ml-2">
                   Editing message
                 </p>
                 <p class="text-xs text-slate-500 dark:text-zinc-500 truncate ml-2">
                   {String.slice(@editing_message.body || "", 0, 80)}
                 </p>
               </div>
               <button phx-click="cancel_edit" class="text-slate-400 hover:text-slate-600 dark:hover:text-zinc-300 p-1">
                 <.icon name="hero-x-mark" class="w-4 h-4"/>
               </button>
            </div>
          <% end %>

          <!-- Main Input Pill container -->
          <form
            id="chat-input-form"
            phx-submit={if @editing_message, do: "save_edit", else: "send_message"}
            phx-change="validate_upload"
            class={[
              "flex items-center gap-3 p-1.5 bg-slate-100 dark:bg-[#1A1A1D] rounded-full",
              (@reply_to || @editing_message || @uploads.attachments.entries != []) && "rounded-t-none mx-4"
            ]}
          >
            <!-- Attachment Button -->
            <div class="pl-1">
              <label class="flex items-center justify-center size-9 rounded-full bg-transparent text-slate-400 dark:text-zinc-500 hover:text-slate-700 dark:hover:text-zinc-300 hover:bg-slate-200/50 dark:hover:bg-white/5 transition-colors cursor-pointer">
                <.icon name="hero-paper-clip" class="w-[22px] h-[22px]"/>
                <div class="hidden">
                   <.live_file_input upload={@uploads.attachments} />
                </div>
              </label>
            </div>
            
            <!-- Vertical thin separator line -->
            <div class="h-6 w-px bg-slate-200 dark:bg-white/10 shrink-0"></div>

            <input
              id="chat-msg-input"
              type="text"
              name="body"
              value={if @editing_message, do: @editing_message.body, else: @message_input}
              placeholder="Type a message..."
              class="flex-1 bg-transparent border-none focus:ring-0 px-2 py-3.5 text-[14px] text-slate-900 dark:text-white placeholder:text-slate-500 dark:placeholder:text-[#616161] min-w-0 font-medium"
              autocomplete="off"
              phx-hook="ChatInput"
              phx-change="message_input_change"
              autofocus
            />

            <!-- Send Button -->
            <button type="submit" class="flex items-center justify-center size-10 rounded-full bg-[#8B5CF6] hover:bg-[#7e53ea] text-white transition-colors active:scale-[0.97] shrink-0 mr-1 disabled:opacity-50" disabled={(String.trim(@message_input || "") == "" && @uploads.attachments.entries == []) && !@editing_message}>
              <.icon name="hero-paper-airplane" class="w-[18px] h-[18px] -rotate-[30deg] ml-0.5 mt-0.5 stroke-2"/>
            </button>
          </form>
        </div>

      <% else %>
        <!-- Empty State -->
        <div class="flex-1 flex items-center justify-center">
          <div class="max-w-md text-center px-6 opacity-40">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">HelpdeskEx Chat</h2>
            <p class="text-sm text-slate-500 dark:text-zinc-400">
              Select a conversation.
            </p>
          </div>
        </div>
      <% end %>
    </main>
  </div>

  <!-- ── MODALS ───────────────────────────────────────────────────────────── -->
  
  <%= if @show_new_chat_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm" phx-click="close_new_chat">
      <div class="bg-white dark:bg-[#1E1E20] rounded-[24px] w-full max-w-md shadow-2xl border border-slate-200 dark:border-white/5 overflow-hidden" phx-click-away="close_new_chat">
        
        <div class="p-5 flex items-center justify-between border-b border-slate-100 dark:border-white/5">
          <h3 class="text-[17px] font-bold text-slate-900 dark:text-white">New direct message</h3>
          <button phx-click="close_new_chat" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-white/5 text-slate-400 transition-colors">
            <.icon name="hero-x-mark" class="w-5 h-5"/>
          </button>
        </div>

        <div class="p-4 border-b border-slate-100 dark:border-white/5">
          <div class="relative">
            <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-slate-400">
              <.icon name="hero-magnifying-glass" class="w-4 h-4"/>
            </div>
            <input type="text" placeholder="Search team members..." phx-keyup="search_users" phx-debounce="200" name="query" autofocus class="w-full bg-slate-50 dark:bg-[#161618] border border-slate-200 dark:border-white/5 rounded-2xl py-3 pl-10 pr-4 text-[14px] text-slate-900 dark:text-white placeholder:text-slate-500 focus:ring-1 focus:ring-[#8B5CF6]/50 focus:border-[#8B5CF6]/50"/>
          </div>
        </div>

        <div class="max-h-[60vh] overflow-y-auto p-2">
          <%= for user <- filtered_users(@tenant_users, @search_query) do %>
            <button phx-click="start_direct_chat" phx-value-user_id={user.id} class="w-full flex items-center gap-3.5 p-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-white/[0.02] transition-colors text-left group">
              <div class="size-10 flex-shrink-0 rounded-full bg-slate-200 dark:bg-[#2C2C2E] text-slate-600 dark:text-zinc-300 font-bold text-[13px] flex items-center justify-center">
                {user_initials(user.full_name)}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[14px] font-semibold text-slate-900 dark:text-white truncate group-hover:text-[#8B5CF6] transition-colors">
                  {user.full_name}
                </p>
                <p class="text-[12px] text-slate-500 dark:text-zinc-500 truncate">{user.email}</p>
              </div>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @show_group_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm">
      <div class="bg-white dark:bg-[#1E1E20] rounded-[24px] w-full max-w-md shadow-2xl border border-slate-200 dark:border-white/5 overflow-hidden flex flex-col max-h-[85vh]">
        
        <div class="p-5 flex items-center justify-between border-b border-slate-100 dark:border-white/5">
          <h3 class="text-[17px] font-bold text-slate-900 dark:text-white">Create a Group</h3>
          <button phx-click="close_group_modal" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-white/5 text-slate-400 transition-colors">
            <.icon name="hero-x-mark" class="w-5 h-5"/>
          </button>
        </div>

        <div class="p-5 border-b border-slate-100 dark:border-white/5 space-y-3">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 dark:text-zinc-500 uppercase tracking-widest mb-2">Group Name</label>
            <input type="text" placeholder="e.g. Project Phoenix" phx-keyup="set_group_name" phx-debounce="100" name="name" class="w-full bg-slate-50 dark:bg-[#161618] border border-slate-200 dark:border-white/5 rounded-2xl px-4 py-3 text-[14px] text-slate-900 dark:text-white focus:ring-1 focus:ring-[#8B5CF6]/50 focus:border-[#8B5CF6]/50 shadow-none font-medium" autofocus/>
          </div>
        </div>

        <div class="flex-1 overflow-y-auto p-4 space-y-1">
          <div class="px-2 pb-2 text-[11px] font-bold text-slate-500 dark:text-zinc-500 uppercase tracking-widest">Select Members</div>
          <%= for user <- @tenant_users do %>
            <button phx-click="toggle_member" phx-value-user_id={user.id} class={["w-full flex items-center gap-3.5 p-3 rounded-2xl transition-all text-left border", user.id in @selected_members && "bg-slate-100 dark:bg-[#242427] border-transparent", user.id not in @selected_members && "hover:bg-slate-50 dark:hover:bg-white/[0.02] border-transparent"]}>
              <div class="size-9 flex-shrink-0 rounded-full bg-slate-200 dark:bg-[#2C2C2E] text-slate-600 dark:text-zinc-300 font-bold text-xs flex items-center justify-center">
                {user_initials(user.full_name)}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[14px] font-semibold text-slate-900 dark:text-white truncate">{user.full_name}</p>
              </div>
              <div class={["size-5 rounded-full border flex items-center justify-center shrink-0 transition-colors", user.id in @selected_members && "bg-[#8B5CF6] border-[#8B5CF6] text-white", user.id not in @selected_members && "bg-transparent border-slate-300 dark:border-[#38383B]"]}>
                 <%= if user.id in @selected_members do %>
                   <.icon name="hero-check" class="w-3.5 h-3.5 stroke-[3]"/>
                 <% end %>
              </div>
            </button>
          <% end %>
        </div>

        <div class="p-5 border-t border-slate-100 dark:border-white/5 bg-slate-50/50 dark:bg-[#161618] flex items-center justify-between">
          <span class="text-[13px] font-medium text-slate-500 dark:text-zinc-400">{length(@selected_members)} member{if length(@selected_members) != 1, do: "s"} selected</span>
          <button phx-click="create_group" disabled={length(@selected_members) < 2} class="px-6 py-2.5 rounded-full bg-[#8B5CF6] disabled:opacity-50 disabled:cursor-not-allowed hover:bg-[#7e53ea] text-white font-bold text-[14px] transition-all">
            Create Group
          </button>
        </div>

      </div>
    </div>
  <% end %>

</Layouts.app>

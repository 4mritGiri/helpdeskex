<Layouts.app
  flash={@flash}
  theme={@theme}
  current_view={@current_view}
  sidebar_collapsed={@sidebar_collapsed}
  current_user={@current_user}
  stats={@stats}
>
  <div class="topbar">
    <span class="topbar-title">
      {case @current_view do
        "kanban" -> "Kanban board"
        "chat" -> "Team Chat"
        "reports" -> "Reports"
        "settings" -> "Settings"
        _ -> "Dashboard"
      end}
    </span>
    <div class="topbar-sep"></div>
    <span class="topbar-tag">Q2 · Apr 2026</span>

    <div class="topbar-actions">
      <%= if @current_view == "kanban" do %>
        <div class="search-bar">
          <svg class="icon-svg" viewBox="0 0 16 16">
            <circle cx="7" cy="7" r="4" /><path d="M10.5 10.5l3 3" />
          </svg>
          Search...
        </div>
      <% end %>

      <div class="theme-icon">
        <svg id="sunIcon" class="icon-svg" viewBox="0 0 16 16">
          <circle cx="8" cy="8" r="3" /><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.2 3.2l1.4 1.4M11.4 11.4l1.4 1.4M3.2 12.8l1.4-1.4M11.4 4.6l1.4-1.4" />
        </svg>
        <div class="theme-toggle" phx-click="toggle_theme" id="themeToggle">
          <div class={["theme-toggle-thumb", @theme == "dark" && "translate-x-[14px]"]}></div>
        </div>
        <svg id="moonIcon" class="icon-svg" viewBox="0 0 16 16">
          <path d="M13 10A6 6 0 016 3a6 6 0 100 10 6 6 0 007-3z" />
        </svg>
      </div>

      <div class="notif-btn" phx-click="toggle_notifications" id="notifBtn">
        <svg class="icon-svg" viewBox="0 0 16 16">
          <path d="M8 1a5 5 0 00-5 5v3l-1.5 2h13L13 9V6a5 5 0 00-5-5zM6.5 13a1.5 1.5 0 003 0" />
        </svg>
        <%= if length(@notifications) > 0 do %>
          <span class="notif-count" id="notifCount">{length(@notifications)}</span>
        <% end %>
      </div>

      <button class="btn-sm btn-primary" phx-click="open_new_ticket">
        <svg class="icon-svg" style="stroke:#fff" viewBox="0 0 16 16">
          <path d="M8 3v10M3 8h10" />
        </svg>
        New ticket
      </button>
    </div>
  </div>

  <%= case @current_view do %>
    <% "kanban" -> %>
      <div class="filter-bar">
        <span class="filter-chip active">All</span>
        <span class="filter-chip">Mine</span>
        <span class="filter-chip">Urgent</span>
        <div class="filter-sep"></div>
        <div class="avatar-stack">
          <div class="av av-purple">SR</div>
          <div class="av av-teal">MA</div>
        </div>
        <span style="font-size:11px;color:var(--text-tertiary);margin-left:8px">4 agents</span>
      </div>

      <div class="board" id="kanban-board" phx-hook="Kanban">
        <%= for status <- @statuses do %>
          <div class="col" id={"col-#{status.id}"}>
            <div class="col-header">
              <div class={["col-dot", "col-dot-#{status.name}"]}></div>
              <span class="col-title">{String.capitalize(status.name)}</span>
              <span class="col-count">{length(tickets_by_status(@tickets, status.name))}</span>
              <div class="col-add" phx-click="open_new_ticket">+</div>
            </div>
            <div class="cards column-body" data-status-id={status.id}>
              <%= for ticket <- tickets_by_status(@tickets, status.name) do %>
                <div
                  class={[
                    "card",
                    sla_breached?(ticket.sla) && "sla-breach",
                    sla_warning?(ticket.sla) && "sla-warn",
                    status.name == "resolved" && "opacity-65"
                  ]}
                  phx-click="select_ticket"
                  phx-value-id={ticket.id}
                  id={"ticket-#{ticket.id}"}
                  data-id={ticket.id}
                >
                  <div class="card-top">
                    <span class="card-id">{short_ticket_id(ticket.id)}</span>
                    <div class="card-badges">
                      <span class={["badge", "b-#{ticket.priority.name}"]}>
                        {String.capitalize(ticket.priority.name)}
                      </span>
                    </div>
                  </div>
                  <div class="card-subject">{ticket.subject}</div>
                  <div class="card-preview">
                    {String.slice(ticket.description || "", 0, 100)}...
                  </div>
                  <div class="card-meta">
                    <div class={["card-av", requester_color(ticket.requester)]}>
                      {requester_initials(ticket.requester)}
                    </div>
                    <span class="card-requester">
                      {if ticket.assigned_to_id == @current_user.id,
                        do: "Assigned to you",
                        else: if(ticket.requester, do: ticket.requester.full_name, else: "User")}
                    </span>
                    <span class={[
                      "card-time",
                      sla_breached?(ticket.sla) && "breach",
                      sla_warning?(ticket.sla) && "warn"
                    ]}>
                      {sla_countdown(ticket) || "No SLA"}
                    </span>
                  </div>
                  <%= if ticket.sla && status.name != "resolved" do %>
                    <div class="sla-bar">
                      <div
                        class={[
                          "sla-fill",
                          sla_breached?(ticket.sla) && "sla-breach-fill",
                          sla_warning?(ticket.sla) && "sla-warn-fill",
                          !sla_breached?(ticket.sla) && !sla_warning?(ticket.sla) && "sla-ok"
                        ]}
                        style={"width: #{sla_progress_percentage(ticket.sla)}%"}
                      >
                      </div>
                    </div>
                  <% end %>
                  <div class="card-footer">
                    <span class="card-attach">
                      <svg class="icon-svg" viewBox="0 0 16 16">
                        <path d="M4 8l4-4 4 4M8 4v9" />
                      </svg>
                      2
                    </span>
                    <%= for tag <- ticket_tags(ticket) do %>
                      <span class="badge b-tag">{tag}</span>
                    <% end %>
                    <span class="card-msgs">
                      <svg class="icon-svg" viewBox="0 0 16 16">
                        <path d="M3 4h10a1 1 0 011 1v5a1 1 0 01-1 1H5l-3 2V5a1 1 0 011-1z" />
                      </svg>
                      {length(ticket.messages)}
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% "chat" -> %>
      <div class="chat-container">
        <div class="chat-messages" id="chat-messages" phx-update="stream">
          <%= for message <- @chat_messages do %>
            <div class="chat-msg group">
              <div class="relative">
                <div class="chat-av">{message.sender.initials}</div>
                <div class="absolute -bottom-1 -right-1 size-3 bg-green-500 border-2 border-white dark:border-zinc-900 rounded-full" />
              </div>
              <div class="chat-content">
                <div class="chat-meta">
                  <span class="chat-user">{message.sender.full_name}</span>
                  <span class="chat-time">{Calendar.strftime(message.inserted_at, "%H:%M")}</span>

                  <div class="ml-auto opacity-0 group-hover:opacity-100 flex items-center gap-2 transition-opacity">
                    <button class="size-6 flex items-center justify-center hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded">
                      <.icon name="hero-face-smile" class="size-4 text-zinc-400" />
                    </button>
                    <button class="size-6 flex items-center justify-center hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded">
                      <.icon name="hero-arrow-uturn-left" class="size-4 text-zinc-400" />
                    </button>
                    <button class="size-6 flex items-center justify-center hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded">
                      <.icon name="hero-ellipsis-horizontal" class="size-4 text-zinc-400" />
                    </button>
                  </div>
                </div>
                <div class="chat-body">{message.body}</div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="chat-input-area">
          <div class="chat-input-wrapper">
            <div class="flex gap-1 ml-2">
              <button class="size-8 flex items-center justify-center hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg text-zinc-500">
                <.icon name="hero-plus-circle" class="size-5" />
              </button>
            </div>
            <input
              type="text"
              placeholder="Type a message or use @ to mention..."
              class="chat-input"
              phx-hook="ChatInput"
              id="chat-input"
            />
            <div class="chat-tools mr-2">
              <button class="tool-btn hover:text-purple-600">
                <.icon name="hero-microphone" class="size-5" />
              </button>
              <button class="tool-btn hover:text-purple-600">
                <.icon name="hero-paper-airplane" class="size-5" />
              </button>
            </div>
          </div>
        </div>
      </div>
    <% "reports" -> %>
      <div style="flex:1; display:flex; align-items:center; justify-content:center; flex-direction:column; color:var(--text-tertiary);">
        <svg
          width="64"
          height="64"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          style="margin-bottom:20px; opacity:0.3;"
        >
          <path d="M21.21 15.89A10 10 0 1 1 8 2.83M22 12A10 10 0 0 0 12 2v10z" />
        </svg>
        <h3 style="font-size:1.5rem; color:var(--text-primary); margin-bottom:8px;">
          Analytics & Reports
        </h3>
        <p>Real-time data visualization is being prepared for your organization.</p>
      </div>
    <% "settings" -> %>
      <div style="padding:40px; max-width:800px; margin:0 auto; width:100%;">
        <h2 style="font-size:1.75rem; font-weight:700; margin-bottom:32px;">
          Workspace Settings
        </h2>
        <div style="display:flex; flex-direction:column; gap:24px;">
          <div style="padding:24px; background:var(--bg-primary); border:1px solid var(--border-color); border-radius:16px;">
            <h4 style="font-size:1rem; font-weight:600; margin-bottom:8px;">Appearance</h4>
            <p style="font-size:14px; color:var(--text-secondary); margin-bottom:16px;">
              Customize how the workspace looks and feels.
            </p>
            <button class="btn-sm">Configure</button>
          </div>
          <div style="padding:24px; background:var(--bg-primary); border:1px solid var(--border-color); border-radius:16px;">
            <h4 style="font-size:1rem; font-weight:600; margin-bottom:8px;">Members</h4>
            <p style="font-size:14px; color:var(--text-secondary); margin-bottom:16px;">
              Invite and manage team members and their roles.
            </p>
            <button class="btn-sm">Manage Team</button>
          </div>

          <div style="padding:24px; background:var(--bg-primary); border:1px solid var(--border-color); border-radius:16px;">
            <h4 style="font-size:1rem; font-weight:600; margin-bottom:8px;">Security</h4>
            <p style="font-size:14px; color:var(--text-secondary); margin-bottom:16px;">
              Secure your account with biometric passkeys.
            </p>

            <div id="passkeys-list" phx-hook="Passkey" class="space-y-3 mb-6">
              <%= if @passkeys == [] do %>
                <div class="text-sm text-slate-400 italic py-2">
                  No passkeys registered yet.
                </div>
              <% else %>
                <%= for pk <- @passkeys do %>
                  <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-white/5 rounded-xl border border-slate-100 dark:border-white/5">
                    <div class="flex items-center gap-3">
                      <div class="p-2 bg-violet-100 dark:bg-violet-900/30 text-violet-600 rounded-lg">
                        <.icon name="hero-finger-print" class="w-5 h-5" />
                      </div>
                      <div>
                        <div class="text-sm font-semibold">{pk.nickname || "My Passkey"}</div>
                        <div class="text-[10px] text-slate-500">
                          Added {Calendar.strftime(pk.inserted_at, "%b %d, %Y")}
                        </div>
                      </div>
                    </div>
                    <button
                      phx-click="delete-passkey"
                      phx-value-id={pk.id}
                      data-confirm="Are you sure you want to remove this passkey?"
                      class="p-2 text-slate-400 hover:text-red-500 transition-colors"
                    >
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  </div>
                <% end %>
              <% end %>
            </div>

            <button class="btn-sm btn-primary" phx-click="register-my-device">
              <svg class="icon-svg mr-1" viewBox="0 0 16 16" style="stroke: #fff;">
                <path d="M8 3v10M3 8h10" />
              </svg>
              Add New Passkey
            </button>
          </div>
        </div>
      </div>
  <% end %>
  
<!-- OVERLAY -->
  <div
    class={[
      "overlay",
      (@show_notifications || @selected_ticket || @show_new_ticket_modal) && "open"
    ]}
    phx-click="close_panel"
  >
  </div>
  
<!-- NOTIFICATION PANEL -->
  <div class={["notif-panel", @show_notifications && "open"]} id="notifPanel">
    <div class="notif-header">
      <span class="notif-header-title">Notifications</span>
      <span style="font-size:11px;background:var(--purple-bg);color:var(--purple-text);padding:2px 8px;border-radius:10px;font-weight:500;">
        {length(@notifications)} new
      </span>
      <button class="notif-clear" phx-click="mark_notifications_read" style="margin-left:8px">
        Mark all read
      </button>
    </div>
    <div class="notif-tabs">
      <div class="notif-tab active">All</div>
      <div class="notif-tab">Assigned to me</div>
      <div class="notif-tab">SLA</div>
    </div>
    <div class="notif-list" id="notifList">
      <%= for notif <- @notifications do %>
        <div class="notif-item unread">
          <div class="notif-av nav-purple">!</div>
          <div class="notif-body">
            <div class="notif-title">{notif.title}</div>
            <div class="notif-desc">{notif.body}</div>
            <div class="notif-time">{Calendar.strftime(notif.inserted_at, "%H:%M")}</div>
          </div>
          <div class="unread-pip"></div>
        </div>
      <% end %>
    </div>
    <div class="notif-footer"><a phx-click="toggle_notifications">Close notifications</a></div>
  </div>
  
<!-- DETAIL PANEL -->
  <div class={["detail-panel", @selected_ticket && "open"]} id="detailPanel">
    <%= if @selected_ticket do %>
      <div class="panel-header">
        <span style="font-weight:700; color: var(--purple-text);">
          {short_ticket_id(@selected_ticket.id)}
        </span>
        <button
          phx-click="close_panel"
          style="background:none;border:none;cursor:pointer;color:var(--text-secondary);padding:4px;display:flex;align-items:center;"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
      <div class="panel-content">
        <h2 style="font-size:1.1rem;font-weight:700;margin:0 0 24px;">
          {@selected_ticket.subject}
        </h2>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px;">
          <div>
            <label style="font-size:0.75rem;color:var(--text-tertiary);display:block;margin-bottom:6px;text-transform:uppercase;font-weight:700;letter-spacing:0.05em;">
              Status
            </label>
            <span style="font-weight:500;color:var(--text-primary);">
              {if @selected_ticket.status,
                do: String.capitalize(@selected_ticket.status.name),
                else: "—"}
            </span>
          </div>
          <div>
            <label style="font-size:0.75rem;color:var(--text-tertiary);display:block;margin-bottom:6px;text-transform:uppercase;font-weight:700;letter-spacing:0.05em;">
              Priority
            </label>
            <span class={["badge", "b-#{@selected_ticket.priority.name}"]}>
              {String.capitalize(@selected_ticket.priority.name)}
            </span>
          </div>
        </div>

        <div style="margin-bottom:24px;">
          <label style="font-size:0.75rem;color:var(--text-tertiary);display:block;margin-bottom:10px;text-transform:uppercase;font-weight:700;letter-spacing:0.05em;">
            Description
          </label>
          <p style="color:var(--text-secondary);line-height:1.7;margin:0;">
            {@selected_ticket.description || "No description provided."}
          </p>
        </div>

        <div style="border-top: 0.5px solid var(--border-color); padding-top: 24px; margin-top: 24px;">
          <label style="font-size:0.75rem;color:var(--text-tertiary);display:block;margin-bottom:16px;text-transform:uppercase;font-weight:700;letter-spacing:0.05em;">
            Conversation
          </label>

          <div
            id="messages-list"
            style="display:flex;flex-direction:column;gap:16px;margin-bottom:24px;"
          >
            <%= for message <- @messages do %>
              <div style="background:var(--bg-secondary);padding:12px;border-radius:8px;border:0.5px solid var(--border-color);">
                <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                  <span style="font-weight:600;font-size:0.85rem;">
                    {message.sender.full_name}
                  </span>
                  <span style="font-size:0.75rem;color:var(--text-tertiary);">
                    {Calendar.strftime(message.inserted_at, "%H:%M")}
                  </span>
                </div>
                <div style="font-size:0.9rem;color:var(--text-secondary);line-height:1.5;">
                  {message.body}
                </div>
              </div>
            <% end %>
          </div>

          <.form for={@message_form} phx-submit="save_message" id="message-form">
            <.input
              field={@message_form[:body]}
              type="textarea"
              placeholder="Type a reply..."
              required
            />
            <button
              type="submit"
              class="btn-sm btn-primary"
              style="width:100%; margin-top: 10px; justify-content: center;"
            >
              Send Message
            </button>
          </.form>
        </div>
      </div>
    <% end %>
  </div>
  <!-- PREMIUM NEW TICKET MODAL -->
  <div
    class={["modal-overlay", @show_new_ticket_modal && "open"]}
    id="new-ticket-modal-overlay"
  >
    <div class="modal-content" phx-click-away="close_new_ticket">
      <div class="modal-header">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 32px; height: 32px; background: var(--purple-bg); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </div>
          <span style="font-weight:700; font-size: 1.25rem; color: #fff;">Create New Ticket</span>
        </div>
        <button
          phx-click="close_new_ticket"
          style="background:rgba(255,255,255,0.05); border:none; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #a1a1a6;"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      <div class="modal-body">
        <div class="modal-form">
          <.form for={@form} phx-change="validate_ticket" phx-submit="save_ticket">
            <div style="display: flex; flex-direction: column; gap: 32px;">
              <div style="display: flex; flex-direction: column; gap: 8px;">
                <label class="field-label">Subject</label>
                <input
                  type="text"
                  name={@form[:subject].name}
                  value={@form[:subject].value}
                  class="premium-input"
                  placeholder="e.g. Broken login page"
                />
              </div>

              <div style="display: flex; flex-direction: column; gap: 8px;">
                <label class="field-label">Priority</label>
                <select name={@form[:priority_id].name} class="premium-input">
                  <option value="">Select priority</option>
                  <%= for p <- @priorities do %>
                    <option value={p.id} selected={@form[:priority_id].value == p.id}>
                      {String.capitalize(p.name)}
                    </option>
                  <% end %>
                </select>
              </div>

              <div style="display: flex; flex-direction: column; gap: 8px;">
                <label class="field-label">Detailed Description</label>
                <textarea
                  name={@form[:description].name}
                  class="premium-input"
                  placeholder="Tell us more about the issue..."
                  style="min-height: 160px;"
                >{ @form[:description].value }</textarea>
              </div>

              <button
                type="submit"
                class="capture-btn"
                style="width: 100%; height: 56px; font-size: 16px; margin-top: 10px;"
              >
                Create Ticket
              </button>
            </div>
          </.form>
        </div>

        <div class="modal-editor" id="screenshot-editor-container">
          <%= if @screenshot do %>
            <div
              class="canvas-container"
              id="editor-canvas-wrapper"
              phx-hook=".ScreenshotEditor"
              phx-update="ignore"
              data-image={@screenshot}
            >
              <canvas id="screenshot-canvas" class="tool-pencil"></canvas>

              <div class="editor-toolbar">
                <div class="color-picker">
                  <div
                    class="color-swatch active"
                    style="background: #7c3aed;"
                    data-color="#7c3aed"
                  >
                  </div>
                  <div class="color-swatch" style="background: #ef4444;" data-color="#ef4444">
                  </div>
                  <div class="color-swatch" style="background: #22c55e;" data-color="#22c55e">
                  </div>
                  <div class="color-swatch" style="background: #f59e0b;" data-color="#f59e0b">
                  </div>
                </div>

                <button class="tool-btn active" id="tool-pencil" title="Draw (P)">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                  </svg>
                </button>
                <button class="tool-btn" id="tool-rect" title="Rectangle (R)">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                  </svg>
                </button>
                <button class="tool-btn" id="tool-arrow" title="Arrow (A)">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </button>
                <button class="tool-btn" id="tool-blur" title="Blur (B)">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" /><path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12z" />
                  </svg>
                </button>
                <button class="tool-btn" id="tool-text" title="Text (T)">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M4 7V4h16v3M9 20h6M12 4v16" />
                  </svg>
                </button>

                <div style="width: 1px; height: 24px; background: rgba(255,255,255,0.1); margin: 0 8px;">
                </div>

                <button class="tool-btn" id="tool-clear" title="Clear All" style="color: #ef4444;">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                  </svg>
                </button>
                <button
                  class="tool-btn"
                  id="tool-remove"
                  phx-click="remove_screenshot"
                  title="Close Editor"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M18 6L6 18M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
          <% else %>
            <div class="capture-placeholder" id="capture-trigger" phx-hook=".ScreenshotCapture">
              <div style="font-size: 64px; margin-bottom: 24px; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.3));">
                🖼️
              </div>
              <h3 style="color: #fff; font-size: 1.5rem; margin-bottom: 12px;">
                Add Visual Context
              </h3>
              <p style="font-size: 15px; line-height: 1.6; color: #a1a1a6; max-width: 300px;">
                Share a screenshot of the issue to help us resolve it faster.
              </p>
              <button
                type="button"
                class="capture-btn"
                style="margin: 32px auto 0; padding: 12px 32px; font-size: 15px; border-radius: 14px;"
              >
                Capture Screenshot
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ScreenshotCapture">
    export default {
      mounted() {
        this.el.addEventListener("click", async () => {
          try {
            const stream = await navigator.mediaDevices.getDisplayMedia({
              video: { cursor: "always" },
              audio: false
            });
            const video = document.createElement("video");
            video.srcObject = stream;
            await video.play();
            const canvas = document.createElement("canvas");
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            const ctx = canvas.getContext("2d");
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            const image = canvas.toDataURL("image/png");
            this.pushEvent("screenshot_captured", { image });
            stream.getTracks().forEach(track => track.stop());
          } catch (err) {
            console.error("Screen capture failed:", err);
          }
        });
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ScreenshotEditor">
    export default {
      mounted() {
        this.init();
      },
      init() {
        const canvas = this.el.querySelector("canvas");
        const ctx = canvas.getContext("2d");
        const img = new Image();
        
        this.state = {
          tool: "pencil",
          color: "#7c3aed",
          isDrawing: false,
          startX: 0,
          startY: 0,
          history: []
        };

        img.onload = () => {
          const container = this.el.getBoundingClientRect();
          const ratio = img.width / img.height;
          let w = container.width - 120;
          let h = w / ratio;
          if (h > container.height - 120) {
            h = container.height - 120;
            w = h * ratio;
          }
          canvas.width = w;
          canvas.height = h;
          ctx.drawImage(img, 0, 0, w, h);
          this.saveHistory();
        };
        img.src = this.el.dataset.image;

        const getPos = (e) => {
          const rect = canvas.getBoundingClientRect();
          return {
            x: (e.clientX - rect.left) * (canvas.width / rect.width),
            y: (e.clientY - rect.top) * (canvas.height / rect.height)
          };
        };

        const setTool = (tool) => {
          this.state.tool = tool;
          this.el.querySelectorAll(".tool-btn").forEach(btn => btn.classList.remove("active"));
          const btn = this.el.querySelector(`#tool-${tool}`);
          if (btn) btn.classList.add("active");
          canvas.className = `tool-${tool}`;
        };

        // Tool bindings
        this.el.querySelector("#tool-pencil").onclick = () => setTool("pencil");
        this.el.querySelector("#tool-rect").onclick = () => setTool("rect");
        this.el.querySelector("#tool-arrow").onclick = () => setTool("arrow");
        this.el.querySelector("#tool-blur").onclick = () => setTool("blur");
        this.el.querySelector("#tool-text").onclick = () => setTool("text");
        this.el.querySelector("#tool-clear").onclick = () => {
          if (this.state.history.length > 0) {
            ctx.putImageData(this.state.history[0], 0, 0);
            this.state.history = [this.state.history[0]];
            this.save();
          }
        };

        // Color picker
        this.el.querySelectorAll(".color-swatch").forEach(swatch => {
          swatch.onclick = () => {
            this.state.color = swatch.dataset.color;
            this.el.querySelectorAll(".color-swatch").forEach(s => s.classList.remove("active"));
            swatch.classList.add("active");
          };
        });

        this.saveHistory = () => {
          this.state.history.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
          if (this.state.history.length > 20) this.state.history.shift();
        };

        canvas.onmousedown = (e) => {
          this.state.isDrawing = true;
          const pos = getPos(e);
          this.state.startX = pos.x;
          this.state.startY = pos.y;
          this.lastState = ctx.getImageData(0, 0, canvas.width, canvas.height);
          
          ctx.strokeStyle = this.state.color;
          ctx.fillStyle = this.state.color;
          ctx.lineWidth = 4;
          ctx.lineCap = "round";
          ctx.lineJoin = "round";

          if (this.state.tool === "pencil") {
            ctx.beginPath();
            ctx.moveTo(pos.x, pos.y);
          }
        };

        const onMouseMove = (e) => {
          if (!this.state.isDrawing) return;
          const pos = getPos(e);

          if (this.state.tool === "pencil") {
            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
          } else if (this.state.tool === "rect") {
            ctx.putImageData(this.lastState, 0, 0);
            ctx.strokeRect(this.state.startX, this.state.startY, pos.x - this.state.startX, pos.y - this.state.startY);
          } else if (this.state.tool === "arrow") {
            ctx.putImageData(this.lastState, 0, 0);
            this.drawArrow(ctx, this.state.startX, this.state.startY, pos.x, pos.y);
          } else if (this.state.tool === "blur") {
            ctx.putImageData(this.lastState, 0, 0);
            this.applyBlur(ctx, this.state.startX, this.state.startY, pos.x - this.state.startX, pos.y - this.state.startY);
          }
        };

        const onMouseUp = (e) => {
          if (!this.state.isDrawing) return;
          this.state.isDrawing = false;
          
          if (this.state.tool === "text") {
            const pos = getPos(e);
            const text = prompt("Enter annotation text:");
            if (text) {
              ctx.font = "bold 24px Inter, sans-serif";
              ctx.fillText(text, pos.x, pos.y);
            }
          }
          
          this.saveHistory();
          this.save();
        };

        this.drawArrow = (ctx, fromx, fromy, tox, toy) => {
          const headlen = 15;
          const dx = tox - fromx;
          const dy = toy - fromy;
          const angle = Math.atan2(dy, dx);
          ctx.beginPath();
          ctx.moveTo(fromx, fromy);
          ctx.lineTo(tox, toy);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(tox, toy);
          ctx.lineTo(tox - headlen * Math.cos(angle - Math.PI / 6), toy - headlen * Math.sin(angle - Math.PI / 6));
          ctx.moveTo(tox, toy);
          ctx.lineTo(tox - headlen * Math.cos(angle + Math.PI / 6), toy - headlen * Math.sin(angle + Math.PI / 6));
          ctx.stroke();
        };

        this.applyBlur = (ctx, x, y, w, h) => {
          ctx.save();
          ctx.beginPath();
          ctx.rect(x, y, w, h);
          ctx.clip();
          ctx.filter = "blur(10px)";
          ctx.drawImage(canvas, 0, 0);
          ctx.restore();
        };

        window.addEventListener("mousemove", onMouseMove);
        window.addEventListener("mouseup", onMouseUp);
        
        this.save = () => {
          const image = canvas.toDataURL("image/png");
          this.pushEvent("screenshot_captured", { image });
        };

        this.destroyed = () => {
          window.removeEventListener("mousemove", onMouseMove);
          window.removeEventListener("mouseup", onMouseUp);
        };
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ChatInput">
    export default {
      mounted() {
        this.scrollToBottom();
        this.el.addEventListener("keydown", e => {
          if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            const val = this.el.value.trim();
            if (val) {
              // In a real app, push event to server
              console.log("Chat message sent:", val);
              this.el.value = "";
            }
          }
          
          if (e.key === "@") {
            console.log("Mention triggered");
            // Show mention list logic here
          }
        });
      },
      updated() {
        this.scrollToBottom();
      },
      scrollToBottom() {
        const container = document.getElementById("chat-messages");
        if (container) {
          container.scrollTop = container.scrollHeight;
        }
      }
    }
  </script>
</Layouts.app>
